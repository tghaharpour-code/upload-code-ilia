<script>
const code = document.getElementById("code");
const viewport = document.getElementById("viewport");
const ending = document.getElementById("ending");
const status = document.getElementById("status");

const templates = [
  "const session = await nova.initialize();",
  "let buffer = new Uint8Array(4096);",
  "function processPacket(data) {",
  "  return data.map(x => x ^ 0x2A);",
  "}",
  "for (let i = 0; i < buffer.length; i++) {",
  "  buffer[i] = Math.floor(Math.random() * 256);",
  "}",
  "const response = { status: 'PROCESSING' };",
  "console.log('NOVA sequence running...');",
  "async function executeStage(index) {",
  "  const result = await simulate(index);",
  "  return { stage: index, result };",
  "}",
  "const matrix = Array.from({length: 8},",
  "  () => Math.random().toString(16).slice(2));",
  "for (const item of matrix) {",
  "  console.log('processing:', item);",
  "}",
  "const checksum = buffer.reduce((a,b) => a+b,0);",
  "await new Promise(resolve => setTimeout(resolve, 10));",
  "const state = { ready: true, mode: 'visual' };",
  "requestAnimationFrame(renderFrame);",
  "const output = JSON.stringify(state);",
  "/* NOVA CYBER TERMINAL */"
];

let active = false;
let timer;
let frame;
let offset = 0;
let startedAt = 0;

function addLines(count=8){
  let output = "";
  for(let i=0;i<count;i++){
    const stamp = new Date().toISOString().slice(11,23);
    const line = templates[Math.floor(Math.random()*templates.length)];
    output += "[" + stamp + "] " + line + "\n";
  }
  code.textContent += output;
  if(code.textContent.length > 18000){
    code.textContent = code.textContent.slice(-12000);
  }
}

function scrollFrame(now){
  if(!active)return;
  if(!startedAt)startedAt=now;
  offset += 0.8;
  code.style.transform = "translateY(-" + offset + "px)";

  if(offset > 120){
    offset = 0;
    code.style.transform = "translateY(0)";
    addLines(7);
  }
  frame = requestAnimationFrame(scrollFrame);
}

function restart(){
  clearTimeout(timer);
  cancelAnimationFrame(frame);
  active = true;
  startedAt = 0;
  offset = 0;
  code.style.transform = "translateY(0)";
  code.textContent = "";
  ending.style.display = "none";
  status.textContent = "● SYSTEM ACTIVE";

  addLines(32);
  frame = requestAnimationFrame(scrollFrame);

  timer = setTimeout(() => {
    active = false;
    cancelAnimationFrame(frame);
    status.textContent = "● SEQUENCE COMPLETE";
    ending.style.display = "flex";
  }, 15000);
}

restart();
</script>
